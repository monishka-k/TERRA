# Variable names only — never values (FR-1.7).
# Copy to .env and fill in. .env is gitignored.

# --- database (Neon) ---
# Use the DIRECT (non-pooled) connection string, not the -pooler host: Martin
# and SQLAlchemy both rely on prepared statements, which the pooler drops.
# Local dev: postgresql://setu:setu@localhost:5432/setu (infra/docker-compose.yml)
DATABASE_URL=
DIRECT_DATABASE_URL=

# Local Postgres container credentials (infra/docker-compose.yml)
POSTGRES_USER=setu
POSTGRES_PASSWORD=setu
POSTGRES_DB=setu

# --- demo (FR-1.4): serve the recorded snapshot, zero live external calls ---
DEMO_MODE=true

# --- Tier B: keyed sources, cached at build time (§8.2a) ---
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
MOSDAC_API_KEY=
IMD_API_KEY=
DATA_GOV_IN_API_KEY=
PLANETARY_COMPUTER_SUBSCRIPTION_KEY=

# --- frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_TILE_BASE_URL=http://localhost:3001

# --- ML model checkpoints (optional, defaults to baseline heuristics) ---
# MODEL_CHECKPOINT_PATH=
# LANDSLIDE_MODEL_PATH=
# FLOOD_MODEL_PATH=
